pipeline {
    agent any  

    stages {
        stage('Checkout') {
            steps {
                git(
                    branch: 'master', 
                    url: 'https://github.com/sunilmalagan/Amazon.git', 
                    credentialsId: 'sunil' 
                )
            }
        }

        stage('Build') {
            steps {
                dir('Amazon') {
                     sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Amazon') {
                     sh 'mvn test'
                }     
            }
        }

        stage('Package') {
            steps {
                dir('Amazon') {
                     sh 'mvn package'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded! Artifacts are built.'
        }
        failure {
            echo 'Pipeline failed! Check the logs for errors.'
        }
    }
}
