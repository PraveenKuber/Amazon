pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven'
    }

    environment {
        GIT_BRANCH = 'main'
        GIT_URL = 'https://github.com/SrinivasP2013/Amazon.git'
        WAR = 'Amazon/Amazon-Web/target/Amazon.war'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_URL}"
            }
        }

        stage('Compile') {
    steps {
        dir('Amazon') {
            sh 'mvn clean compile'
        }
    }
}

        stage('Test') {
        dir('Amazon') { 
            steps {
                sh 'mvn test'
            }
        }
        }
        stage('Package') {
            dir('Amazon') { 
            steps {
                sh 'mvn package -DskipTests'
            }
        }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${WAR}",
                                 fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
