pipeline{
agent any

stages{
stage('FINF POM.XML'){
steps{
sh 'cd /var/lib/jenkins/jobs/jenkinsfile-sky/workspace'
sh 'ls -la'
sh 'find . -name pom.xml'
sh 'echo "./SKY/SKY-Core/pom.xml"'
}
}
stage('BUILD'){
steps {
dir('SKY/SKY-Core') {
            sh 'pwd'
            sh 'ls -la'
           sh'mvn clean package'
}
}
}
stage('TEST'){
steps {
sh 'mvn clean'
}
}
stage('BUILD & INSTALL STAGE'){
steps{
sh 'mvn clean install'
}
}
stage('DEPLOY') {
steps {
echo 'pipeline completed successfully'
}
}


}
}

