pipeline {
    agent any

    stages {

        stage('FIND POM.XML') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'find . -name pom.xml'
            }
        }

        stage('BUILD') {
            steps {
                dir('SpringNew') {
                    sh 'pwd'
                    sh 'ls -la'
                    sh 'mvn clean package'
                }
            }
        }

        stage('TEST') {
            steps {
                dir('SpringNew') {
                    sh 'mvn test'
                }
            }
        }

        stage('BUILD & INSTALL') {
            steps {
                dir('SpringNew') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('DEPLOY') {
            steps {
                echo 'SpringNew pipeline completed successfully'
            }
        }
    }
}
